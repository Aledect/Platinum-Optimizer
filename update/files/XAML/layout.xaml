                                </Border>
                                <!-- Option 5 -->
                                <Border x:Name="CARD_BUGFIX_5" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderMain}" BorderThickness="1" CornerRadius="14" Margin="10,12" Padding="25">                            <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#232733" BorderBrush="#2A2F3D" BorderThickness="1" CornerRadius="10" Width="46" Height="46" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" Foreground="#00B4DB" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Repair Print Spooler Service" Foreground="#FFF" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center"/>
