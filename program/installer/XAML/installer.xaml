<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Platinum+ Setup"
        Height="440" Width="640"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True" RenderOptions.EdgeMode="Aliased">
    <Window.Resources>
        <!-- Blue Cyan Radial Glow -->
        <RadialGradientBrush x:Key="GlowBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#1500B4DB" Offset="0"/>
            <GradientStop Color="#0000B4DB" Offset="1"/>
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="ProgressBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0088A8" Offset="0"/>
            <GradientStop Color="#00B4DB" Offset="0.48"/>
            <GradientStop Color="#58E6FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OptionCardNormal" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A1F2E" Offset="0"/>
            <GradientStop Color="#141822" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OptionCardSelected" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A2A3A" Offset="0"/>
            <GradientStop Color="#14222E" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="OptionButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CardBorder"
                                Background="{StaticResource OptionCardNormal}"
                                BorderBrush="#252A36"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Padding="20,16"
                                Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.3" ShadowDepth="2"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="42" Height="42" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <Ellipse Fill="#0A00B4DB" Opacity="0.25"/>
                                    <Ellipse x:Name="CheckEllipse" Width="20" Height="20" Fill="Transparent"
                                             Stroke="#3A4252" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse x:Name="InnerDot" Width="10" Height="10" Fill="#00B4DB"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform ScaleX="0" ScaleY="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="OptionTitle" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"
                                               Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="OptionDesc" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                               Foreground="#6B7280" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource OptionCardSelected}"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#00B4DB"/>
                                <Setter TargetName="CheckEllipse" Property="Fill" Value="#0A00B4DB"/>
                                <Setter TargetName="CheckEllipse" Property="Stroke" Value="#00B4DB"/>
                                <Setter TargetName="OptionTitle" Property="Foreground" Value="#00D4FF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="InnerDot"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="InnerDot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="InnerDot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="InnerDot"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="InnerDot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="InnerDot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#3A4A5A"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00B4DB" Offset="0"/>
                        <GradientStop Color="#0088A8" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="12" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect Color="#00B4DB" BlurRadius="24" Opacity="0.45" ShadowDepth="0"/>
                            </Border.Effect>
                            <Grid>
                                <TextBlock x:Name="BTN_TEXT" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                           Foreground="White" FontSize="17" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#00D4FF" Offset="0"/>
                                            <GradientStop Color="#00A0C0" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0077A3" Offset="0"/>
                                            <GradientStop Color="#005F7F" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <TextBlock x:Name="ArrowText"
                                       Text="&lt;"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0.5"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowText" Property="Foreground" Value="#00B4DB"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowText"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1.0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="ArrowText"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="-4" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowText"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.5" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="ArrowText"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ArrowText" Property="Foreground" Value="#0088A8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <!-- Text content (the X) that also animates -->
                            <TextBlock x:Name="CloseText" 
                                       Text="{TemplateBinding Content}" 
                                       Foreground="{TemplateBinding Foreground}" 
                                       FontSize="{TemplateBinding FontSize}" 
                                       FontWeight="{TemplateBinding FontWeight}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Opacity="0.6"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        <RotateTransform Angle="0"/>
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseText" Property="Foreground" Value="#E81123"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Animate text opacity to full and rotate 90 degrees -->
                                            <DoubleAnimation Storyboard.TargetName="CloseText"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1.0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="CloseText"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(RotateTransform.Angle)"
                                                             To="90" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Revert text opacity and rotate back to 0 -->
                                            <DoubleAnimation Storyboard.TargetName="CloseText"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.6" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="CloseText"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(RotateTransform.Angle)"
                                                             To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseText" Property="Foreground" Value="#C4101E"/>
                                <Setter TargetName="CloseText" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                            <RotateTransform Angle="90"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="INSTALL_ROOT" Opacity="0">
        <Border Background="#0E1015" CornerRadius="24" BorderBrush="#252A36" BorderThickness="1">


            <Grid>
                <!-- Drag Area (top bar) -->
                <Rectangle x:Name="DragArea" 
                           Fill="Transparent" 
                           Height="50"
                           VerticalAlignment="Top"
                           Cursor="Hand"/>

                <!-- Back button (top-left, visible only on Screen2) -->
                <Button x:Name="BTN_BACK" Content="&#x2190;" Foreground="#6B7280" Background="Transparent"
                        BorderThickness="0" FontSize="18" Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Width="36" Height="36" Margin="12,12,0,0" FontWeight="Bold"
                        Visibility="Collapsed"
                        Panel.ZIndex="1000"
                        Style="{StaticResource BackButtonStyle}"/>


                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                    <Grid Margin="0,30,0,30">
                        
<!-- Screen 1: Welcome -->
<StackPanel x:Name="Screen1"
            Opacity="0"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

    <!-- Logo -->
    <Grid x:Name="LogoGrid"
          Width="200"
          Height="200"
          HorizontalAlignment="Center"
          Margin="0,0,0,-20">

        <Ellipse Width="150"
                 Height="150"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="#0A00B4DB"
                 Opacity="0.2"/>

        <Image x:Name="IMG_INSTALLER_LOGO"
               Width="200"
               Height="200"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               CacheMode="BitmapCache">
            <Image.Effect>
                <DropShadowEffect Color="#00B4DB"
                                   BlurRadius="20"
                                   Opacity="0.4"
                                   ShadowDepth="0"/>
            </Image.Effect>
        </Image>
    </Grid>

    <!-- Title -->
    <TextBlock Text="Platinum+ Optimizer"
               Foreground="White"
               FontSize="34"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,0,0,2"/>

    <!-- Subtitle -->
    <TextBlock Text="SETUP WIZARD"
               Foreground="#00B4DB"
               FontSize="12"
               FontWeight="SemiBold"
               HorizontalAlignment="Center"
               Margin="0,0,0,18"/>

    <!-- Button -->
    <Button x:Name="BTN_INSTALL_NOW"
            Content="INSTALL NOW"
            Width="280"
            Height="60"
            HorizontalAlignment="Center"
            Margin="0,10,0,0"
            Style="{StaticResource PrimaryButtonStyle}"/>
</StackPanel>

                        <!-- Screen 2: Installation Options -->
                        <StackPanel x:Name="Screen2" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Installation Mode" Foreground="White" FontSize="26" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Select how you want to deploy Platinum+ Optimizer" Foreground="#6B7280" FontSize="13" 
                                       HorizontalAlignment="Center" Margin="0,0,0,32"/>

                            <!-- Options Panel -->
                            <StackPanel x:Name="OptionsPanel" Margin="0,0,0,40" Width="460">
                                <RadioButton x:Name="OPT_NORMAL" GroupName="InstallType"
                                             Style="{StaticResource OptionButtonStyle}"
                                             Content="Typical Installation"
                                             Tag="Standard installation in the system. Creates Start Menu and Desktop shortcuts. Recommended for most users."
                                             IsChecked="True"
                                             Margin="0,0,0,16"/>
                                <RadioButton x:Name="OPT_PORTABLE" GroupName="InstallType"
                                             Style="{StaticResource OptionButtonStyle}"
                                             Content="Portable Mode"
                                             Tag="Extracts the executable without installing it to the system registry. Ideal for USB flash drives."/>
                            </StackPanel>

                            <!-- Start Button -->
                            <Button x:Name="BTN_START_INSTALL" Content="NEXT" Width="300" Height="60" 
                                    HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>

                        <!-- Screen 3: Update or Reinstall -->
                        <StackPanel x:Name="Screen3" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="Screen3Title" Text="Update or Reinstall?" Foreground="#00B4DB" FontSize="26" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="Screen3Message1" Text="A previous installation of Platinum+ Optimizer was detected."
                                       Foreground="#6B7280" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock x:Name="Screen3Message2" Text="Do you want to reinstall or update the existing copy?"
                                       Foreground="#6B7280" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,0,0,32"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BTN_INSTALL_ANYWAY" Content="CONTINUE ANYWAY" Width="200" Height="50"
                                        Cursor="Hand" FontSize="16" FontWeight="Bold" Margin="0,0,10,0">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0095B8" Offset="0"/>
                                            <GradientStop Color="#007A96" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="InstallBorder" CornerRadius="12" Background="{TemplateBinding Background}">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#0095B8" BlurRadius="24" Opacity="0.45" ShadowDepth="0"/>
                                                </Border.Effect>
                                                <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="InstallBorder" Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#00B5D8" Offset="0"/>
                                                                <GradientStop Color="#009AB6" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="InstallBorder" Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#007590" Offset="0"/>
                                                                <GradientStop Color="#005A76" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="BTN_CANCEL_WARN" Content="CLOSE" Width="130" Height="50"
                                        Background="#5A2020" Foreground="White" BorderThickness="0"
                                        Cursor="Hand" FontSize="16" FontWeight="Bold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CloseBorder" CornerRadius="12" Background="{TemplateBinding Background}">
                                                <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseBorder" Property="Background" Value="#E81123"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="CloseBorder" Property="Background" Value="#C4101E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Screen 4: Portable Path Picker -->
                        <StackPanel x:Name="Screen4" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">
                            <TextBlock Text="Portable Location" Foreground="White" FontSize="26" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Select the folder where Platinum+ will be copied." Foreground="#6B7280" FontSize="13" 
                                       HorizontalAlignment="Center" Margin="0,0,0,32"/>

                            <Grid Margin="0,0,0,32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" Background="#181A21" BorderBrush="#252A36" BorderThickness="1" CornerRadius="8,0,0,8" Height="46">
                                    <TextBox x:Name="TXT_PORTABLE_PATH" Text="" Foreground="White" Background="Transparent" 
                                             BorderThickness="0" VerticalAlignment="Center" Padding="12,0" FontSize="13"/>
                                </Border>
                                
                                <Button x:Name="BTN_BROWSE" Grid.Column="1" Content="BROWSE" Width="100" Height="46" 
                                        Background="#1E2230" Foreground="White" BorderBrush="#252A36" BorderThickness="0,1,1,1" 
                                        Cursor="Hand" FontWeight="Bold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0,8,8,0">
                                                <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Start Button -->
                            <Button x:Name="BTN_START_PORTABLE" Content="START INSTALLATION" Width="300" Height="60" 
                                    HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>

                        <!-- Progress Panel -->
                        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">

                            <!-- Titolo -->
                            <TextBlock Text="Installing..." Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <!-- Barra di avanzamento + Percentuale alla fine -->
                            <Grid Width="500" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="430"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="430" Height="8" Background="#181A21" CornerRadius="4" BorderBrush="#252A36" BorderThickness="1" HorizontalAlignment="Left">
                                    <Grid ClipToBounds="True">
                                        <Border x:Name="INSTALL_PROGRESS" Width="430" Height="8"
                                                Background="{StaticResource ProgressBrush}" CornerRadius="3"
                                                HorizontalAlignment="Left" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="ProgressFillScale" ScaleX="0" ScaleY="1"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="TXT_PERCENT" Grid.Column="1" Text="0%" Foreground="#00B4DB" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Width="70" TextAlignment="Right"/>
                            </Grid>

                            <!-- Testo stato corrente -->
                            <TextBlock x:Name="TXT_INSTALL_STATUS" Text="Starting installation..." Foreground="#6B7280"
                                       FontSize="13" HorizontalAlignment="Center" Margin="0,16,0,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                        </StackPanel>

                        <!-- Completed Panel -->
                        <StackPanel x:Name="CompletedPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">

                            <!-- Checkmark -->
                            <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,24">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00B4DB" Offset="0"/>
                                        <GradientStop Color="#0088A8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#00B4DB" BlurRadius="20" Opacity="0.5" ShadowDepth="0"/>
                                </Border.Effect>
                                <TextBlock Text="✓" Foreground="White" FontSize="28" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Titolo -->
                            <TextBlock Text="Installation Complete" Foreground="White" FontSize="24"
                                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                            <!-- Sottotitolo -->
                            <TextBlock x:Name="TXT_COMPLETED_INFO" Text="Platinum+ Optimizer has been installed successfully."
                                       Foreground="#6B7280" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,32"
                                       TextWrapping="Wrap" TextAlignment="Center"/>

                            <!-- Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BTN_LAUNCH" Content="DIRECTORY" Width="160" Height="48"
                                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0"
                                        Visibility="Collapsed"/>
                                <Button x:Name="BTN_CLOSE2" Content="CLOSE" Width="160" Height="48"
                                        Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>

                        </StackPanel>

                    </Grid>
                </ScrollViewer>

                <!-- Close button -->
                <Button x:Name="BTN_CLOSE" Content="✕" Foreground="#6B7280" Background="Transparent"
                        BorderThickness="0" FontSize="14" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="36" Height="36" Margin="0,12,12,0" FontWeight="Bold" 
                        Panel.ZIndex="1000"
                        Style="{StaticResource CloseButtonStyle}"/>
            </Grid>
        </Border>
    </Grid>
</Window>