                                        <TextBlock Grid.Row="1" Text="Flushes DNS, resets Winsock sockets, and clears IP stack routing tables. Ideal for solving complex connection and undefined LAN/WiFi network adapter glitches." Foreground="{StaticResource TextDim}" FontSize="13" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,25" MinHeight="75"/>
