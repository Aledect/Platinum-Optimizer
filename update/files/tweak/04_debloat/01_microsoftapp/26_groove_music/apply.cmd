powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "Get-Process -Name *ZuneMusic*,*Music.UI*,*MediaPlayer* -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; Get-AppxPackage -AllUsers *Microsoft.ZuneMusic* -ErrorAction SilentlyContinue | Remove-AppxPackage -AllUsers -ErrorAction SilentlyContinue; Get-AppxProvisionedPackage -Online -ErrorAction SilentlyContinue | Where-Object { $_.PackageName -like '*Microsoft.ZuneMusic*' } | Remove-AppxProvisionedPackage -Online -ErrorAction SilentlyContinue"
exit /b 0
