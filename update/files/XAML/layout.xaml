                                                    <Border x:Name="BTN_INFO_BUGFIX_6" Width="20" Height="20" Background="#14171E" BorderBrush="{StaticResource BorderMain}" BorderThickness="1" CornerRadius="10" Cursor="Hand" ToolTip="Click for details" VerticalAlignment="Center">
                                                        <TextBlock Text="?" Foreground="{StaticResource TextDim}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="Force re-registers all Windows Store manifests via the AppX module. Vital for rescuing modern native applications (Settings, Photos, Store, etc.) that crash instantly upon opening." Foreground="{StaticResource TextDim}" FontSize="13" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,25" MinHeight="75"/>
                                        <Button x:Name="BTN_RUN_BUGFIX_6" Grid.Row="2" Content="Run Fix" Style="{StaticResource PrimaryBlueBtn}" Height="38" FontSize="13" FontWeight="Bold" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </Border>
                                <!-- Option 7 -->
                                <Border x:Name="CARD_BUGFIX_7" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderMain}" BorderThickness="1" CornerRadius="14" Margin="10,12" Padding="25">                            <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
                                    <Grid>
