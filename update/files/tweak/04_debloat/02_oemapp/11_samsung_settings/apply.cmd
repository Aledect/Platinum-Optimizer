powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.Path -like '*SamsungSettings*' } | Stop-Process -Force -ErrorAction SilentlyContinue; Get-AppxPackage -AllUsers *SamsungSettings* | Remove-AppxPackage -ErrorAction SilentlyContinue; Get-AppxProvisionedPackage -Online -ErrorAction SilentlyContinue | Where-Object { $_.PackageName -like '*SamsungSettings*' } | Remove-AppxProvisionedPackage -Online -ErrorAction SilentlyContinue; Remove-Item -Path 'C:\Users\*\AppData\Local\Packages\*SamsungSettings*' -Recurse -Force -ErrorAction SilentlyContinue"
