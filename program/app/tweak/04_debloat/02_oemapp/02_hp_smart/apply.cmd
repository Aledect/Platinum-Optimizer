powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "Get-Process | Where-Object { $_.Name -like '*HPPrinterControl*' -or $_.Name -like '*HP.Smart*' -or $_.Name -like '*HPSmart*' } | Stop-Process -Force -ErrorAction SilentlyContinue; Get-AppxPackage -AllUsers | Where-Object { $_.Name -like '*HPPrinterControl*' -or $_.Name -like '*HP.Smart*' } | Remove-AppxPackage -AllUsers -ErrorAction SilentlyContinue; Get-AppxProvisionedPackage -Online | Where-Object { $_.PackageName -like '*HPPrinterControl*' -or $_.PackageName -like '*HP.Smart*' } | Remove-AppxProvisionedPackage -Online -ErrorAction SilentlyContinue; Remove-Item -Path 'C:\Users\*\AppData\Local\Packages\*HPPrinterControl*','C:\Users\*\AppData\Local\Packages\*HP.Smart*' -Recurse -Force -ErrorAction SilentlyContinue"
exit /b 0
