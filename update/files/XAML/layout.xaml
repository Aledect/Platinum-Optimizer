                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="Scans the OS image for corruption and replaces damaged native DLLs or configurations. Executes an SFC and DISM sequence against Windows Update repositories to deeply verify and repair core infrastructure." Foreground="{StaticResource TextDim}" FontSize="13" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,25" MinHeight="75"/>
                                        <Button x:Name="BTN_RUN_BUGFIX_3" Grid.Row="2" Content="Run Fix" Style="{StaticResource PrimaryBlueBtn}" Height="38" FontSize="13" FontWeight="Bold" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </Border>
                                <!-- Option 4 -->
                                <Border x:Name="CARD_BUGFIX_4" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderMain}" BorderThickness="1" CornerRadius="14" Margin="10,12" Padding="25">                            <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
