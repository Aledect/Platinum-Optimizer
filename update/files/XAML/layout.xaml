                                        <TextBlock Grid.Row="1" Text="Clears pending update cache and restarts BITS/services to resolve update loop errors. Renames SoftwareDistribution and catroot2 folders forcing Windows to regenerate update definitions clean." Foreground="{StaticResource TextDim}" FontSize="13" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,25" MinHeight="75"/>
                                        <Button x:Name="BTN_RUN_BUGFIX_1" Grid.Row="2" Content="Run Fix" Style="{StaticResource PrimaryBlueBtn}" Height="38" FontSize="13" FontWeight="Bold" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </Border>
                                <!-- Option 2 -->
                                <Border x:Name="CARD_BUGFIX_2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderMain}" BorderThickness="1" CornerRadius="14" Margin="10,12" Padding="25">                            <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
