powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "Get-Process -Name OneDrive,FileCoAuth,OneDriveSetup -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; Get-Service -Name OneSyncSvc* -ErrorAction SilentlyContinue | Stop-Service -Force -ErrorAction SilentlyContinue; @(\"$env:SystemRoot\SysWOW64\OneDriveSetup.exe\", \"$env:SystemRoot\System32\OneDriveSetup.exe\") | Where-Object { Test-Path $_ } | ForEach-Object { Start-Process -FilePath $_ -ArgumentList '/uninstall' -Wait -NoNewWindow -ErrorAction SilentlyContinue }; Get-AppxPackage -AllUsers *OneDrive* -ErrorAction SilentlyContinue | Remove-AppxPackage -ErrorAction SilentlyContinue; Get-AppxProvisionedPackage -Online -ErrorAction SilentlyContinue | Where-Object { $_.PackageName -like '*OneDrive*' } | Remove-AppxProvisionedPackage -Online -ErrorAction SilentlyContinue; @(\"$env:LocalAppData\Microsoft\OneDrive\", \"$env:ProgramData\Microsoft OneDrive\", \"$env:SystemDrive\OneDriveTemp\") | Where-Object { Test-Path $_ } | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue"
exit /b 0
